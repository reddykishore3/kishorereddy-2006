Question 4 – Mobile Phone Battery Performance

import numpy as np

# 1. Generate battery percentages for 20 time intervals
np.random.seed(42)
battery = np.random.randint(5, 101, 20)

print("Battery Readings:")
print(battery)

# 2. First, fifth, tenth, and last readings
print("\nFirst Reading:", battery[0], "%")
print("Fifth Reading:", battery[4], "%")
print("Tenth Reading:", battery[9], "%")
print("Last Reading:", battery[-1], "%")

# 3. Battery values below 20%
below_20 = battery[battery < 20]

print("\nBattery Below 20%:")
print(below_20)

# 4. Battery levels between 30% and 70%
between_30_70 = battery[(battery >= 30) & (battery <= 70)]

print("\nBattery Between 30% and 70%:")
print(between_30_70)

# 5. Average battery percentage
average = np.mean(battery)

print("\nAverage Battery:", average, "%")

# 6. Minimum and maximum battery percentage
print("Minimum Battery:", np.min(battery), "%")
print("Maximum Battery:", np.max(battery), "%")

# 7. Variance and standard deviation
print("Variance:", np.var(battery))
print("Standard Deviation:", np.std(battery))

# 8. Count readings below average
below_average = np.sum(battery < average)

print("\nReadings Below Average:", below_average)

# 9. Sum of all battery readings
total = np.sum(battery)

print("Sum of All Battery Readings:", total, "%")

# 10. Save results into battery.csv
np.savetxt(
    "battery.csv",
    battery,
    delimiter=",",
    header="Battery_Percentage",
    comments="",
    fmt="%d"
)

print("\nBattery data saved to battery.csv")

