import numpy as np

# 1. Generate electricity consumption for 12 months
np.random.seed(42)
consumption = np.random.randint(100, 801, 12)

print("Monthly Electricity Consumption:")
print(consumption)

# 2. First 3 months
print("\nFirst 3 Months:")
print(consumption[:3])

# 3. Last month's consumption using negative indexing
print("\nLast Month Consumption:", consumption[-1], "units")

# 4. Calculate electricity bill at ₹6 per unit
bill = consumption * 6

print("\nElectricity Bill for Each Month:")
print(bill)

# 5. Filter months consuming more than 500 units
above_500 = consumption[consumption > 500]

print("\nConsumption Above 500 Units:")
print(above_500)

# 6. Minimum and maximum consumption
print("\nMinimum Consumption:", np.min(consumption), "units")
print("Maximum Consumption:", np.max(consumption), "units")

# 7. Total annual electricity consumption
total = np.sum(consumption)

print("\nTotal Annual Consumption:", total, "units")

Question 3 – Monthly Electricity Consumption

# 8. Average, variance and standard deviation
average = np.mean(consumption)

print("Average Consumption:", average, "units")
print("Variance:", np.var(consumption))
print("Standard Deviation:", np.std(consumption))

# 9. Count months below average
below_average = np.sum(consumption < average)

print("\nMonths Below Average:", below_average)

# 10. Save monthly data into electricity.csv
data = np.column_stack((consumption, bill))

np.savetxt(
    "electricity.csv",
    data,
    delimiter=",",
    header="Consumption_Units,Bill_Rs",
    comments="",
    fmt="%.2f"
)

print("\nMonthly data saved to electricity.csv")

