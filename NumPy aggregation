import numpy as np

# 1D Array
sales = np.array([100, 200, 150, 300, 250])

print("1D Array:", sales)

print("Total:", np.sum(sales))
print("Average:", np.mean(sales))
print("Minimum:", np.min(sales))
print("Maximum:", np.max(sales))
print("Product:", np.prod(sales))
print("Standard Deviation:", np.std(sales))
print("Variance:", np.var(sales))
print("Number of Elements:", sales.size)

# 2D Array
data = np.array([
    [10, 20, 30],
    [40, 50, 60]
])

print("\n2D Array:")
print(data)

# All elements
print("Total of all values:", np.sum(data))

# Column-wise aggregation
print("Column-wise Sum:", np.sum(data, axis=0))
print("Column-wise Mean:", np.mean(data, axis=0))
print("Column-wise Minimum:", np.min(data, axis=0))
print("Column-wise Maximum:", np.max(data, axis=0))

# Row-wise aggregation
print("Row-wise Sum:", np.sum(data, axis=1))
print("Row-wise Mean:", np.mean(data, axis=1))
print("Row-wise Minimum:", np.min(data, axis=1))
print("Row-wise Maximum:", np.max(data, axis=1))

